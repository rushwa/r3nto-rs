# RentoLink Rust Environment Configuration

# Database
DATABASE_URL=postgres://postgres:password@localhost/rento_rs

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server
PORT=8000
HOST=0.0.0.0

# Frontend
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@rentolink.com

# Infobip SMS
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_SENDER_ID=RentoLink
SMS_ENABLED=true
SMS_DEBUG=true

# WhatsApp
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TEMPLATE_APPROVED=false

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Redis (for sessions & task queue)
REDIS_URL=redis://localhost:6379

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

OPENAI_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
OPENAI_API_KEY="sk-ws-H.XEIHEP.UcmZ.MEUCIQDtZVtNRKXQr_SyLk68nfdxbcooAGHVzXbzrOZjYmfEOAIgGDSu4dbEdAo9QT1r51lzv05zAwnAh9P4AH2Cwze0Rr0"
